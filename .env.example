# Rummage backend — environment variables. Copy to .env for local dev; set
# the same names (with real values) in Render's dashboard for production.
# Every one of these is optional unless noted — the server runs and scrapes
# listings fine with none of them set, individual features just stay off.

# --- Price Check (Claude vision item ID + resale estimate) ---
# Required for POST /api/identify-item and POST /api/price-check — without
# it both return 503 "Price Check isn't set up yet". Get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=
# Defaults to https://api.anthropic.com. Override only to point local dev at
# a compatible local gateway instead of the real (billed) API.
ANTHROPIC_BASE_URL=

# --- Optional scraping sources ---
# EstateSales.org, via the lulzasaur/estate-sales-scraper Apify actor
# ($10/1k results). Falls back to a slower direct Puppeteer scrape if unset.
APIFY_TOKEN=
# Google Custom Search (optional extra listings source) + Places API (the
# vintage-store locator). Get CX at https://programmablesearchengine.google.com
GOOGLE_API_KEY=
GOOGLE_CX=
# Static map thumbnails. Free tier (3,000/day, no card) at
# https://myprojects.geoapify.com
GEOAPIFY_KEY=

# --- Email (verification codes, daily digest, feedback) ---
RESEND_API_KEY=
RESEND_FROM=
FEEDBACK_EMAIL=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- iOS push notifications (APNs) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENV=

# --- Daily-digest subscriber storage ---
# Render's free tier has no persistent disk, so a plain JSON file gets wiped
# on every deploy. Set these to persist subscribers in Upstash Redis
# instead; unset falls back to a local JSON file (fine for local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Misc ---
PORT=
PUBLIC_BASE_URL=
CHROME_PATH=
